<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    QLNV.Api — tang API (§5).
    LUU Y CHO TAC TU VIET Program.cs: tep nay do tac tu "controller nghiep vu" tao ra vi
    project chua ton tai. Neu ban can them goi (JWT, Swagger, EF Design...) hay BO SUNG
    vao day, DUNG GHI DE toan bo tep — cac goi duoi day la BAT BUOC cho controller.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QLNV.Api</RootNamespace>
    <AssemblyName>QLNV.Api</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Can van hoa vi-VN de dinh dang ngay/so dung; khong bat che do bat bien. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kiem tra du lieu dau vao (§5, moi request DTO co mot validator o thu muc Validators/). -->
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
    <!-- Controller truy van du lieu qua DbContext (kieu CO SO, xem ghi chu o TroGiupNghiepVu). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <!-- Xac thuc JWT tu phat hanh (§10.11: secret doc tu cau hinh, khong hard-code). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!--
      BO SUNG boi tac tu viet Program.cs (khong ghi de cac dong tren):
      - FluentValidation.AspNetCore: can cho AddFluentValidationAutoValidation() de
        validator o thu muc Validators/ chay TU DONG truoc khi vao action.
        Goi nay keo theo FluentValidation + DependencyInjectionExtensions, NuGet se
        thong nhat len phien ban 11.9.2 da ghim o tren.
      - Microsoft.EntityFrameworkCore.Design: de chay "dotnet ef migrations" voi
        project khoi dong la QLNV.Api.
    -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QLNV.Core\QLNV.Core.csproj" />
    <ProjectReference Include="..\QLNV.Infrastructure\QLNV.Infrastructure.csproj" />
  </ItemGroup>

</Project>
