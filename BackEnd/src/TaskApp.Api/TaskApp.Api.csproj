<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TaskApp.Api</RootNamespace>
    <AssemblyName>TaskApp.Api</AssemblyName>
    <!-- Sinh tep XML de Swagger doc duoc chu thich /// tren controller -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591: thieu chu thich XML tren thanh vien public - khong can canh bao -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>taskapp-quan-ly-nhiem-vu</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- CHI MOT goi Oracle. Goi nay da keo Oracle.ManagedDataAccess.Core theo dang phu thuoc;
         cai them goi do bang tay se gay xung dot assembly luc chay. -->
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26300" />

    <!-- Chi phuc vu cong cu dotnet-ef luc phat trien, khong di kem ban phat hanh -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
  </ItemGroup>

</Project>
